<div class="vd-split-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="vd-split-hero__inner">
    <div class="vd-split-hero__text-area{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <div class="vd-split-hero__text-content">
        {% if section.settings.eyebrow != blank %}
          <p class="vd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h1 class="vd-split-hero__title">{{ section.settings.heading | escape }}</h1>
        {% if section.settings.text != blank %}
          <div class="vd-split-hero__copy">{{ section.settings.text }}</div>
        {% endif %}
        <div class="vd-split-hero__actions">
          {% if section.settings.primary_label != blank %}
            <a class="button button--primary" {% if section.settings.primary_link != blank %}href="{{ section.settings.primary_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.primary_label | escape }}</a>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="vd-split-hero__media-area{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <div class="vd-split-hero__image-wrapper">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '500, 750, 1000, 1500, 2000', sizes: '(min-width: 990px) 50vw, 100vw', fetchpriority: 'high', class: 'vd-split-hero__image' }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'vd-split-hero__image placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "VelnorDesk Split Hero",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Minimalist Workspace"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Desk Setup."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Experience true focus with our premium PU leather and felt desk pads. Crafted for perfection.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "VelnorDesk Split Hero"
    }
  ]
}
{% endschema %}
