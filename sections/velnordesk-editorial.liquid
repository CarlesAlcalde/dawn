<div class="vd-section vd-editorial color-{{ section.settings.color_scheme }} gradient"><div class="vd-page"><div class="vd-editorial__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="vd-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '375, 550, 750, 1100, 1500, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}{% else %}<div class="vd-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>{% endif %}</div>
  <div class="vd-editorial__content"><p class="vd-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="vd-title">{{ section.settings.heading | escape }}</h2><div class="vd-copy">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<div class="vd-actions"><a class="button button--primary" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label | escape }}</a></div>{% endif %}</div>
</div></div></div>
{% schema %}
{"name":"VelnorDesk editorial","class":"section","settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Workspace clarity"},{"type":"text","id":"heading","label":"Heading","default":"Less Clutter. More Focus."},{"type":"richtext","id":"text","label":"Text","default":"<p>Everything on your desk should have a purpose.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Shop the Setup"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"VelnorDesk editorial"}]}
{% endschema %}
