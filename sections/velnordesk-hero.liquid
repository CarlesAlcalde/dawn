<div class="vd-section vd-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="vd-page vd-hero__grid">
    <div class="vd-hero__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {% if section.settings.eyebrow != blank %}<p class="vd-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1 class="vd-title vd-hero__title">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.text != blank %}<div class="vd-copy">{{ section.settings.text }}</div>{% endif %}
      <div class="vd-actions">
        {% if section.settings.primary_label != blank %}<a class="button button--primary" {% if section.settings.primary_link != blank %}href="{{ section.settings.primary_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.primary_label | escape }}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="button button--secondary" {% if section.settings.secondary_link != blank %}href="{{ section.settings.secondary_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.secondary_label | escape }}</a>{% endif %}
      </div>
    </div>
    <div class="vd-media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '375, 550, 750, 1100, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', fetchpriority: 'high' }}
      {% else %}
        <div class="vd-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {% endif %}
    </div>
  </div>
</div>
{% schema %}
{"name":"VelnorDesk hero","class":"section","settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Premium workspace essentials"},{"type":"text","id":"heading","label":"Heading","default":"Build a Better Desk."},{"type":"richtext","id":"text","label":"Text","default":"<p>Minimal workspace essentials designed to keep your desk clean, organized, and distraction-free.</p>"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"primary_label","label":"Primary button label","default":"Shop Desk Essentials"},{"type":"url","id":"primary_link","label":"Primary button link"},{"type":"text","id":"secondary_label","label":"Secondary button label","default":"Explore Collections"},{"type":"url","id":"secondary_link","label":"Secondary button link"}],"presets":[{"name":"VelnorDesk hero"}]}
{% endschema %}
