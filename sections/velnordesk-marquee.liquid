<div class="vd-marquee color-{{ section.settings.color_scheme }} gradient">
  <div class="vd-marquee__track">
    <div class="vd-marquee__content">
      {% for block in section.blocks %}
        <span class="vd-marquee__item">
          {% if block.settings.icon != blank %}<span class="vd-marquee__icon">{{ block.settings.icon }}</span>{% endif %}
          <span>{{ block.settings.text | escape }}</span>
        </span>
      {% endfor %}
    </div>
    <div class="vd-marquee__content" aria-hidden="true">
      {% for block in section.blocks %}
        <span class="vd-marquee__item">
          {% if block.settings.icon != blank %}<span class="vd-marquee__icon">{{ block.settings.icon }}</span>{% endif %}
          <span>{{ block.settings.text | escape }}</span>
        </span>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "VelnorDesk Marquee",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Marquee item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji or icon",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Premium Desk Accessories"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VelnorDesk Marquee",
      "blocks": [
        { "type": "item", "settings": { "icon": "✨", "text": "Premium Vegan PU Leather" } },
        { "type": "item", "settings": { "icon": "🛡️", "text": "70% Non-Slip Suede Backing" } },
        { "type": "item", "settings": { "icon": "💧", "text": "Wipe-Clean Waterproof Finish" } },
        { "type": "item", "settings": { "icon": "🌿", "text": "Soft & Durable Felt Fabric" } },
        { "type": "item", "settings": { "icon": "⚡", "text": "Fast Shipping & Easy Returns" } }
      ]
    }
  ]
}
{% endschema %}
