<div class="vd-hotspots-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="vd-hotspots__heading h1 center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    
    <div class="vd-hotspots__container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="vd-hotspots__image-wrap">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2400 | image_tag: fetchpriority: 'auto', class: 'vd-hotspots__img' }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'vd-hotspots__img placeholder-svg' }}
        {% endif %}
      </div>

      {% for block in section.blocks %}
        <div class="vd-hotspot" style="top: {{ block.settings.top_position }}%; left: {{ block.settings.left_position }}%;">
          <div class="vd-hotspot__dot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14m-7-7h14"></path></svg>
          </div>
          <div class="vd-hotspot__tooltip">
            <div class="vd-hotspot__tooltip-inner">
              <h4 class="vd-hotspot__product-title">{{ block.settings.product_title | escape }}</h4>
              {% if block.settings.product_price != blank %}
                <p class="vd-hotspot__price">{{ block.settings.product_price | escape }}</p>
              {% endif %}
              {% if block.settings.product_link != blank %}
                <a href="{{ block.settings.product_link }}" class="vd-hotspot__link">View Product &rarr;</a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop The Setup Hotspots",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop The Setup"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Setup Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "limit": 5,
      "settings": [
        {
          "type": "range",
          "id": "top_position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left_position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Left Position",
          "default": 50
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title",
          "default": "Premium Desk Pad"
        },
        {
          "type": "text",
          "id": "product_price",
          "label": "Price",
          "default": "$49.00"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop The Setup Hotspots",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "top_position": 40,
            "left_position": 60
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "top_position": 70,
            "left_position": 30
          }
        }
      ]
    }
  ]
}
{% endschema %}
