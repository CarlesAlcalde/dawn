<div class="vd-section vd-categories color-{{ section.settings.color_scheme }} gradient"><div class="vd-page">
  <div class="vd-section-head"><h2 class="vd-title">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="vd-copy">{{ section.settings.text }}</div>{% endif %}</div>
  <div class="vd-grid vd-grid--4">{% for block in section.blocks %}<a class="vd-card vd-category" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}><div class="vd-category__image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 25vw, 100vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div><div class="vd-category__body"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.cta | escape }} →</p></div></a>{% endfor %}</div>
</div></div>
{% schema %}
{"name":"VelnorDesk categories","class":"section","settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"text","id":"heading","label":"Heading","default":"Shop by workspace need"},{"type":"text","id":"text","label":"Subtitle","default":"Build your setup one thoughtful detail at a time."}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Desk Mats"},{"type":"text","id":"cta","label":"CTA","default":"Shop now"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"VelnorDesk categories","blocks":[{"type":"category","settings":{"title":"Desk Mats"}},{"type":"category","settings":{"title":"Cable Management"}},{"type":"category","settings":{"title":"Desk Organization"}},{"type":"category","settings":{"title":"Workspace Accessories"}}]}]}
{% endschema %}
