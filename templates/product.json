{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping",
            "icon": "truck",
            "content": "<p>Shipping options and delivery estimates are shown at checkout.</p>",
            "page": ""
          }
        },
        "returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Returns",
            "icon": "return",
            "content": "<p>Review the store return policy for eligibility and instructions.</p>",
            "page": ""
          }
        },
        "details": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Product details",
            "icon": "clipboard",
            "content": "<p>See the product description and specifications above for materials, sizing, and care details.</p>",
            "page": ""
          }
        },
        "benefits": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "check_mark",
            "heading_1": "Clean setup ready",
            "icon_2": "truck",
            "heading_2": "Reliable delivery",
            "icon_3": "return",
            "heading_3": "Easy support"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "benefits",
        "description",
        "shipping",
        "returns",
        "details",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 24
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Complete your setup",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
